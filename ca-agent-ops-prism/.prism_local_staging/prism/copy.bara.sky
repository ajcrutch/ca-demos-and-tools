# copy.bara.sky
load("//devtools/copybara/library/compliance", "generate_license_file")
load(
    "//devtools/copybara/library/scrubbing",
    "doc_scrub",
    "message_extract_public_description",
    "py_scrub",
)
load("//devtools/copybara/library/ts_js", "default_css_license_glob", "web_add_license_spdx")

py_license_header = """# Copyright 2026 Google LLC
#
# Licensed under the Apache License, Version 2.0 (the "License");
# you may not use this file except in compliance with the License.
# You may obtain a copy of the License at
#
#      http://www.apache.org/licenses/LICENSE-2.0
#
# Unless required by applicable law or agreed to in writing, software
# distributed under the License is distributed on an "AS IS" BASIS,
# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
# See the License for the specific language governing permissions and
# limitations under the License."""

markdown_license_header = """<!--
Copyright 2026 Google LLC

Licensed under the Apache License, Version 2.0 (the "License");
you may not use this file except in compliance with the License.
You may obtain a copy of the License at

     http://www.apache.org/licenses/LICENSE-2.0

Unless required by applicable law or agreed to in writing, software
distributed under the License is distributed on an "AS IS" BASIS,
WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
See the License for the specific language governing permissions and
limitations under the License.
-->
"""

origin_files = glob(
    include = [
        "src/**",  # Include all files under src/
        "pyproject.toml",
        ".gitignore",
        "README.md",
        "alembic/**",
        "scripts/**",
        "Dockerfile",
        "alembic.ini",
        "tests/**",
        "uv.lock",
    ],
    exclude = [
        "BUILD",
        "**/BUILD",
        "METADATA",
        "OWNERS",
        "copy.bara.sky",
        "**/*.pyc",
        "src/**/__pycache__/**",
        "**/prism.egg-info/**",
    ],
)

# destination_files prevents deletion of files in the destination
# not coming from the source.
destination_files = glob(
    ["**"],
    exclude = [
        ".git/**",  # Exclude the whole .git directory
    ],
)

core.workflow(
    name = "prism_to_oss_local",
    origin = folder.origin(),
    destination = folder.destination(),
    authoring = authoring.overwrite("pmiv <pmiv@google.com>"),
    origin_files = origin_files,
    destination_files = destination_files,
    transformations = [
        # 1. Scrub internal info from all files
        py_scrub(),
        doc_scrub(),
        # MUST run before transformations that read the LICENSE file.
        generate_license_file(
            package_path = ".",  # Generate at the root
            spdx_identifiers = ["Apache-2.0"],
            copyright_year = "2026",  # Update year as necessary
            copyright_author = "Google LLC",
        ),

        # 2. Add license headers to Python files within src/
        core.replace(
            before = "${start}",
            after = py_license_header + "\n\n${start}",
            paths = glob(["src/**/*.py"]),
            first_only = True,
            multiline = True,
            regex_groups = {
                "start": "\\A",
            },
        ),

        # 3. Add license headers to Markdown files
        core.replace(
            before = "${start}",
            after = markdown_license_header + "\n${start}",
            paths = glob(["**.md"]),
            first_only = True,
            multiline = True,
            regex_groups = {
                "start": "\\A",
            },
        ),

        # 4. Add license headers to CSS files (Example, if you have them)
        web_add_license_spdx(
            license_path = "LICENSE",  # Assumes LICENSE file will be generated
            css_paths = default_css_license_glob,
        ),

        # 5. Format Python files using Pyformat (includes import sorting)
        # Pyformat will use the pyproject.toml moved to the root.
        format.paths(paths = glob(["src/**/*.py"])),

        # 7. Security check
        leakr.check(),
    ],
    ask_for_confirmation = True,
)
